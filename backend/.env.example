# 实验室物料库存管理系统 - 环境变量配置文件
# 复制此文件为 .env 并修改其中的值

# Flask 配置
FLASK_APP=run.py
FLASK_CONFIG=production

# 密钥配置（使用强密码，可以使用 openssl rand -base64 32 生成）
SECRET_KEY=your-production-secret-key-change-this
JWT_SECRET_KEY=your-production-jwt-secret-key-change-this

# 首次初始化账号（仅首次创建数据库时使用）
INITIAL_ADMIN_PASSWORD=change-this-initial-admin-password
INITIAL_VISITOR_USERNAME=visitor
INITIAL_VISITOR_PASSWORD=change-this-initial-visitor-password

# 数据库配置 - MySQL
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://lab_user:your_password@localhost:3306/lab_inventory?charset=utf8mb4

# 邮件配置 - 用于库存预警通知
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# 前端来源；同源部署可留空，独立本地前端按实际地址填写
CORS_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:8080

# 阿里云邮件服务配置（如果使用阿里云邮件推送）
# MAIL_SERVER=smtpdm.aliyun.com
# MAIL_PORT=465
# MAIL_USE_TLS=false
# MAIL_USE_SSL=true
# MAIL_USERNAME=noreply@your-domain.com
# MAIL_PASSWORD=your_aliyun_smtp_password
